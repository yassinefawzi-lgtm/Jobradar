# --- Base de données ---------------------------------------------------------
# Production : Supabase > Project Settings > Database > Connection string > "Transaction pooler"
# Développement : `pnpm db:local` démarre un PostgreSQL local sur ce port.
DATABASE_URL=postgres://jobradar@localhost:5433/jobradar

# --- Accès à l'application ----------------------------------------------------
# Mot de passe de connexion (long et unique) et secret de signature de session (32+ caractères aléatoires).
APP_PASSWORD=
SESSION_SECRET=

# --- Sources -------------------------------------------------------------------
# HelloWork : collecte autorisée, aucune clé. Mettre 0 pour désactiver.
SOURCE_HELLOWORK_ENABLED=1
# Adzuna : https://developer.adzuna.com (inscription gratuite)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# France Travail : https://francetravail.io (application + abonnement à l'API "Offres d'emploi v2")
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Synchronisation -----------------------------------------------------------
# Nombre maximal de requêtes HTTP par source et par synchronisation, et pause entre deux requêtes (ms).
SYNC_MAX_REQUESTS_PER_SOURCE=150
SYNC_REQUEST_DELAY_MS=1500

# --- IA (phase 2 : rédaction des CV et lettres) ------------------------------------
# Clé API Claude : https://console.anthropic.com > API Keys. Sans clé, JobRadar rédige sans IA.
ANTHROPIC_API_KEY=
# Plafond mensuel estimé en euros ; au-delà, rédaction sans IA jusqu'au mois suivant.
AI_MONTHLY_BUDGET_EUR=10

# --- Déclenchement de la synchro (phase 4) -----------------------------------------
# Cron Vercel (vercel.json) → workflow GitHub « Synchro ». Valeur aléatoire longue.
CRON_SECRET=
# Jeton GitHub à grain fin (ce dépôt seulement, permission Actions : lecture et écriture).
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=yassinefawzi-lgtm/jobradar
